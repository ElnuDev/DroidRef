<resources>

  <!-- Base application theme. -->
  <style name="AppTheme" parent="Theme.AppCompat.NoActionBar">
    <!-- Customize your theme here. -->
    <item name="colorPrimary">@color/colorPrimaryDark</item>
    <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
    <item name="colorAccent">@color/colorAccent</item>
    <item name="colorControlActivated">@color/enabled</item>
    <item name="colorControlNormal">@color/disabled</item>
  </style>

  <!-- Every toolbar button: a 24dp icon over a short label, on a shared
       rounded background. Labels can be turned off in View settings. -->
  <style name="ToolbarButton">
    <item name="android:layout_width">wrap_content</item>
    <item name="android:layout_height">@dimen/toolbar_button_labelled</item>
    <item name="android:minWidth">@dimen/toolbar_button_width</item>
    <item name="android:background">@drawable/toolbar_button_bg</item>
    <item name="android:clickable">true</item>
    <item name="android:focusable">true</item>
    <item name="android:gravity">center</item>
    <item name="android:paddingStart">5dp</item>
    <item name="android:paddingEnd">5dp</item>
    <item name="android:paddingTop">6dp</item>
    <item name="android:paddingBottom">6dp</item>
    <item name="android:includeFontPadding">false</item>
    <item name="android:maxLines">1</item>
    <item name="android:textSize">10sp</item>
    <item name="android:textColor">@android:color/white</item>
  </style>

</resources>
